{
  "name": "pcloud-browser",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "issues": {
        "enabled": false
      },
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": false,
        "persist": false
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
